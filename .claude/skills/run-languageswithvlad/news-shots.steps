# The pictures of the News page (src/lib/news.ts, the image field), light and dark, 390 px.
# Run from the repo root with yarn dev on port 5173:
#   node .claude/skills/run-languageswithvlad/driver.mjs --out public/news < .claude/skills/run-languageswithvlad/news-shots.steps
# One block per picture, separated by ---; a failed step skips the rest of its block only.
# Add a block for every new News entry that shows something on screen.

# --- Home, the day of a lesson, the next one tomorrow
scenario upcoming
nav /
click button Sync
wait-text Revise before the lesson
shot-element .home-card.prepare-card news-revise-before
shot-element .home-card.lesson-summary news-lesson-summary
shot-element .homework-card news-homework-home
shot-element .send-to-teacher news-send-to-teacher
shot-element header.top news-top-bar
---
nav /
click button Write
fill .homework-card textarea @0 Hier, je suis levé à sept heures.
click button Check
wait-text Hier, je me suis levé à sept heures.
shot-element .homework-card news-written-homework
---
# --- a lesson's pages
nav /lessons
wait-text Leçon 1
shot-element ul.words news-key-words
click tab /^Grammar/
wait-text Les verbes pronominaux
shot-element section.panel news-lesson-extras
---
# --- Settings
nav /settings
shot-element section.settings-card:has(h2:text-is("Lesson tabs")) news-lesson-tabs
shot-element section.settings-card:has(h2:text-is("Interface")) news-languages
shot-element section.settings-card:has(h2:text-is("Profile")) news-settings
---
# --- the menu, opened
nav /
click button Show the menu
shot-element nav.sections news-menu
---
# --- during a lesson
scenario now
nav /
click button Sync
wait-text Lesson now
shot-element header.top news-live-sync
click link /Enter the lesson/
shot-element section.call-card:has-text("Google Meet") news-lesson-mode
shot-element section.call-card:has-text("Warm-up") news-warm-up
click button Open the board
# the board (Excalidraw) loads on demand
wait-for section.lesson-board .excalidraw canvas
shot-element section.lesson-board news-board
---
scenario now
nav /call
click button Play
shot-element section.warm-up news-quiz-game
---
# --- after the lesson
scenario finished
nav /
click button Sync
wait-text finished
shot-element .next-lesson-widget news-lesson-finished
---
# --- other sections
scenario upcoming
nav /discuss
click button Write a question
wait-text Qu’est-ce que vous faites
shot-element article.discussion news-discussion
---
nav /photo
shot-element main news-photo
---
nav /text
fill main textarea @0 Le matin, je vais à la boulangerie. J’achète le pain pour toute la famille.
click button Read this text
click-text boulangerie
click button Explain
wait-text A shop where bread is baked and sold.
shot-element section.panel.solo news-text-analysis
---
nav /
click button /Feedback/
shot-element dialog.report-dialog news-feedback
---
# --- help links and tooltips
nav /lessons
hover link How this section works
shot-element section.sheet news-help
---
# --- the teacher's tools (Settings → Teacher first)
nav /settings
fill section.settings-card input[type=password] @0 test-teacher
click button Turn on teacher tools
wait-text This device has the teacher tools on.
shot-element section.settings-card:has(h2:text-is("Teacher")) news-teacher-settings
nav /lessons
click tab /^Homework/
click button Make homework with Claude
wait-text Décrivez votre matin
shot-element .make-homework news-make-homework
