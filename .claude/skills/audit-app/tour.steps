# Every page, lesson tab and main exercise, one screenshot each, for:
#   node .claude/skills/run-languageswithvlad/driver.mjs --out "$TMPDIR/audit-shots" < .claude/skills/audit-app/tour.steps
# A line "---" ends a block: a failed step skips only the rest of its block.
nav /
shot home
---
nav /lessons
shot lesson-words
click tab /^Verbs/
shot lesson-verbs-list
click button /se lever/
shot lesson-verbs-table
click button Practise this tense
fill table.conj input @0 me lève
fill table.conj input @2 elle se lève
fill table.conj input @3 nous levons
click button Check answers
shot lesson-verbs-drill-checked
---
nav /lessons
click tab /^Grammar/
shot lesson-grammar
click tab /^Homework/
shot lesson-homework
click tab /^Book exercises/
shot lesson-book
click tab /^My notes/
shot lesson-notes
click tab /^Original/
shot lesson-original
---
# the German lesson is dated yesterday in the test data: the second newest link, not a fixed date
nav /lessons
eval (()=>{const links=[...document.querySelectorAll('a.lesson-link')];links[links.length-2].click();return 1})()
wait-text aufstehen
shot lesson-german
# its three words make the one group with 3 words: the Exercise button works there
click button /An exercise on the words of “Morning routine”/
wait-text Question 1 of
shot group-exercise
---
# a group with fewer than 3 words shows a note instead of the button
nav /lessons
wait-text An exercise needs at least 3 ticked words
shot group-note
---
nav /lessons
click tab /^Phonetics/
wait-text The sound
shot lesson-phonetics
click button Practise
wait-text Question 1 of
shot phonetics-round
