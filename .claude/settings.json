{
  "permissions": {
    "allow": [
      "Bash(yarn typecheck)",
      "Bash(yarn -s typecheck)",
      "Bash(yarn lint)",
      "Bash(yarn -s lint)",
      "Bash(yarn verify)",
      "Bash(yarn -s verify)",
      "Bash(yarn format:check)",
      "Bash(yarn -s format:check)",
      "Bash(npm view *)",
      "Bash(dig *)",
      "mcp__Claude_Browser__read_console_messages"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 60,
            "statusMessage": "ESLint + Prettier"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.sh",
            "timeout": 120,
            "statusMessage": "yarn typecheck"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/news-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
